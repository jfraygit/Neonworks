<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Lumen</AssemblyName>
    <RootNamespace>Lumen</RootNamespace>
    <Version>$(LumenVersion)</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Interop assemblies are reference-only; never copy 127 DLLs into bin. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- BepInEx 6 IL2CPP framework -->
  <ItemGroup>
    <Reference Include="BepInEx.Core"><HintPath>$(BepInExCore)\BepInEx.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.IL2CPP"><HintPath>$(BepInExCore)\BepInEx.Unity.IL2CPP.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx.Unity.Common"><HintPath>$(BepInExCore)\BepInEx.Unity.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(BepInExCore)\Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Common"><HintPath>$(BepInExCore)\Il2CppInterop.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExCore)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Game assemblies. Hx* volumetric types live in firstpass, everything else in Assembly-CSharp. -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(BepInExInterop)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(BepInExInterop)\Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.Postprocessing.Runtime"><HintPath>$(BepInExInterop)\Unity.Postprocessing.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SALSA-LipSync"><HintPath>$(BepInExInterop)\SALSA-LipSync.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MagicaCloth"><HintPath>$(BepInExInterop)\MagicaCloth.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Unity interop assemblies -->
  <ItemGroup>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(BepInExInterop)\Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(BepInExInterop)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(BepInExInterop)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(BepInExInterop)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(BepInExInterop)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(BepInExInterop)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(BepInExInterop)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextCoreModule"><HintPath>$(BepInExInterop)\UnityEngine.TextCoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(BepInExInterop)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(BepInExInterop)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AnimationModule"><HintPath>$(BepInExInterop)\UnityEngine.AnimationModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(BepInExInterop)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AIModule"><HintPath>$(BepInExInterop)\UnityEngine.AIModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Drop the built plugin straight into the game so a build is immediately testable. -->
  <Target Name="InstallToGame" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <MakeDir Directories="$(BepInExDir)\plugins\Lumen" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\Lumen" ContinueOnError="true" />
    <Message Importance="high" Text="Lumen installed to $(BepInExDir)\plugins\Lumen" />
  </Target>

</Project>
